# MusicFree JS plugin or JSON plugin list, URLs or local paths; comma-separated or a JSON array.
MUSICFREE_SOURCES=https://fastly.jsdelivr.net/gh/Huibq/keep-alive/Music_Free/myPlugins.json
MUSICFREE_PORT=3300
MUSICFREE_HOST=127.0.0.1
# Exact browser origin when gateway and Folia have different origins; empty for a same-origin proxy.
MUSICFREE_ALLOW_ORIGIN=http://localhost:3000
# Set a stable random secret (openssl rand -hex 32) to preserve queued items across server restarts.
MUSICFREE_ITEM_SECRET=
