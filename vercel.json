{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs/CODEMAP.md'",
  "rewrites": [
    {
      "source": "/api/musicfree/:path*",
      "destination": "/api/musicfree?path=/:path*"
    },
    {
      "source": "/api/qq/:path*",
      "destination": "/api/qq?path=/:path*"
    }
  ],
  "functions": {
    "api/musicfree.js": {
      "maxDuration": 300,
      "includeFiles": "musicfree-gateway/**",
      "excludeFiles": "musicfree-gateway/.env*"
    }
  }
}
